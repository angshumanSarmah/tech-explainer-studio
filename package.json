{
  "name": "tech-explainer-studio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Offline VideoScript v1 validation for Tech Explainer Studio",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "bin": {
    "studio": "dist/cli/index.js"
  },
  "scripts": {
    "studio": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-audio-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/visual/*.test.ts tests/audio/*.test.ts tests/integration/*.test.ts",
    "test:visual": "node tests/visual/verify.ts",
    "lint": "biome check src tests scripts package.json narration.config.example.json narration.mock.example.json tsconfig.json tsconfig.build.json biome.json",
    "format": "biome check --write src tests scripts package.json narration.config.example.json narration.mock.example.json tsconfig.json tsconfig.build.json biome.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
